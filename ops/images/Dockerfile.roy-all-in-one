ARG HERMES_AGENT_IMAGE
ARG CURRENT_ROY_IMAGE
FROM ${HERMES_AGENT_IMAGE} AS hermes_candidate
FROM ${CURRENT_ROY_IMAGE}

USER root

ARG HERMES_WEBUI_REPO=https://github.com/rcortese/hermes-webui.git
ARG HERMES_WEBUI_REV=fe84511935c78533aaf5ab5518411813753416f7

# Preserve Roy's tested all-in-one supervisor, but refresh the Agent runtime
# and WebUI tree from the release-pinned sources.
COPY --from=hermes_candidate --chown=99:100 /opt/hermes /opt/hermes
RUN test "$(id -u hermes)" = "99" && test "$(id -g hermes)" = "100" \
    && cd /opt/hermes && /opt/hermes/.venv/bin/hermes --version \
    && /opt/hermes/.venv/bin/python3 -m py_compile gateway/run.py hermes_cli/config.py hermes_cli/kanban.py
RUN rm -rf /opt/hermes-webui \
    && git clone "${HERMES_WEBUI_REPO}" /opt/hermes-webui \
    && cd /opt/hermes-webui \
    && git checkout --detach "${HERMES_WEBUI_REV}" \
    && test "$(git rev-parse HEAD)" = "${HERMES_WEBUI_REV}" \
    && uv pip install --python /opt/hermes/.venv/bin/python3 --no-cache-dir pytest -r requirements.txt \
    && /opt/hermes/.venv/bin/python3 -m py_compile api/agent_health.py api/config.py api/gateway_chat.py api/profiles.py api/routes.py api/streaming.py server.py \
    && /opt/hermes/.venv/bin/python3 -c 'from api.streaming import _title_prompts; _, p = _title_prompts("Audit deployment method", "Release inputs diverged"); assert len(p) == 2; assert any("main topic and substantive intent" in x for x in p); assert all("Do not prioritize method, format, tool, role" in x for x in p)' \
    && /opt/hermes/.venv/bin/python3 -m pytest -o addopts= -q tests/test_agent_health_remote.py tests/test_webui_gateway_chat_backend.py tests/test_remote_cron_proxy_guard.py tests/test_ai_crowd_title_topic_priority.py \
    && printf "__version__ = '%s'\n" "$(git describe --tags --always --dirty)" > api/_version.py \
    && rm -rf /opt/hermes-webui/.git \
    && chown -R 99:100 /opt/hermes-webui
RUN git config --system --add safe.directory /opt/hermes && chown -R 99:100 /opt/hermes
USER root
