ARG ROY_BASE_IMAGE
FROM ${ROY_BASE_IMAGE}

USER root

# Every WebUI byte is bound to an explicit repository revision and the Git
# archive checksum supplied by the source-only builder. No branch/tag/default
# is accepted here.
ARG HERMES_WEBUI_REPO
ARG HERMES_WEBUI_REV
ARG HERMES_WEBUI_ARCHIVE_SHA256

RUN test "$(id -u hermes)" = "99" \
    && test "$(id -g hermes)" = "100" \
    && test -n "${HERMES_WEBUI_REPO}" \
    && printf '%s' "${HERMES_WEBUI_REV}" | grep -Eq '^[0-9a-f]{40}$' \
    && printf '%s' "${HERMES_WEBUI_ARCHIVE_SHA256}" | grep -Eq '^[0-9a-f]{64}$'

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

# Clone only to ask Git for the exact immutable object, then verify the archive
# before extraction. The finished image deliberately contains no WebUI .git.
COPY ops/scripts/verify-hermes-webui-api-server-contract.py /tmp/verify-hermes-webui-api-server-contract.py
RUN git clone --no-checkout "${HERMES_WEBUI_REPO}" /tmp/hermes-webui-source \
    && cd /tmp/hermes-webui-source \
    && git checkout --detach "${HERMES_WEBUI_REV}" \
    && test "$(git rev-parse HEAD)" = "${HERMES_WEBUI_REV}" \
    && git archive --format=tar "${HERMES_WEBUI_REV}" > /tmp/hermes-webui.tar \
    && printf '%s  %s\n' "${HERMES_WEBUI_ARCHIVE_SHA256}" /tmp/hermes-webui.tar | sha256sum -c - \
    && python3 /tmp/verify-hermes-webui-api-server-contract.py /tmp/hermes-webui.tar \
    && mkdir -p /opt/hermes-webui \
    && tar -xf /tmp/hermes-webui.tar -C /opt/hermes-webui \
    && test -f /opt/hermes-webui/server.py \
    && test -f /opt/hermes-webui/api/gateway_chat.py \
    && test ! -e /opt/hermes-webui/.git \
    && uv pip install --python /opt/hermes/.venv/bin/python3 --no-cache-dir -r /opt/hermes-webui/requirements.txt \
    && /opt/hermes/.venv/bin/python3 -m py_compile /opt/hermes-webui/server.py /opt/hermes-webui/api/gateway_chat.py \
    && rm -rf /tmp/hermes-webui-source /tmp/hermes-webui.tar /tmp/verify-hermes-webui-api-server-contract.py \
    && chown -R 99:100 /opt/hermes-webui

# Roy is intentionally single-venv: WebUI uses the Hermes runtime Python.
RUN test ! -e /opt/hermes-webui/venv \
    && HERMES_WEBUI_AGENT_DIR=/opt/hermes \
       HERMES_WEBUI_STATE_DIR=/tmp/hermes-webui-build-check \
       HERMES_WEBUI_DEFAULT_WORKSPACE=/agents/roy/private \
       /opt/hermes/.venv/bin/python3 - <<'PY'
from pathlib import Path
import importlib
import sys

if not sys.executable.startswith('/opt/hermes/.venv/'):
    raise SystemExit(f'wrong Python executable for WebUI import: {sys.executable}')
if Path('/opt/hermes-webui/venv').exists():
    raise SystemExit('/opt/hermes-webui/venv must not exist in Roy all-in-one image')
sys.path.insert(0, '/opt/hermes-webui')
importlib.import_module('server')
PY

COPY ops/images/roy-all-in-one.supervisor.conf /etc/supervisor/conf.d/roy-all-in-one.conf

ENV PATH="/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}" \
    HOME=/opt/data \
    HERMES_HOME=/opt/data \
    HERMES_WEBUI_AGENT_DIR=/opt/hermes \
    HERMES_WEBUI_HOST=0.0.0.0 \
    HERMES_WEBUI_PORT=8787 \
    HERMES_WEBUI_STATE_DIR=/opt/data/webui \
    HERMES_WEBUI_DEFAULT_WORKSPACE=/agents/roy/private \
    HERMES_DASHBOARD=1 \
    HERMES_DASHBOARD_HOST=127.0.0.1 \
    HERMES_DASHBOARD_PORT=9123 \
    HERMES_DASHBOARD_TUI=1

WORKDIR /agents/roy/private

ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/roy-all-in-one.conf", "-n"]
CMD []
