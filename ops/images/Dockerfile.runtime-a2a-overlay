ARG HERMES_AGENT_IMAGE
ARG CURRENT_RUNTIME_IMAGE
FROM ${HERMES_AGENT_IMAGE} AS hermes_candidate
FROM ${CURRENT_RUNTIME_IMAGE}

USER root

# Preserve the reviewed all-in-one runtime shell while replacing only the
# byte-reviewed Persona RPC implementation from the immutable Hermes candidate.
COPY --from=hermes_candidate --chown=99:100 /opt/hermes/gateway/persona_api.py /opt/hermes/gateway/persona_api.py
COPY --from=hermes_candidate --chown=99:100 /opt/hermes/gateway/readiness.py /opt/hermes/gateway/readiness.py
COPY --from=hermes_candidate --chown=99:100 /opt/hermes/gateway/platforms/api_server.py /opt/hermes/gateway/platforms/api_server.py
COPY --from=hermes_candidate --chown=99:100 /opt/hermes/tools/environments/local.py /opt/hermes/tools/environments/local.py
COPY --from=hermes_candidate --chown=99:100 /opt/hermes/tools/persona_rpc.py /opt/hermes/tools/persona_rpc.py
COPY --from=hermes_candidate --chown=99:100 /opt/hermes/toolsets.py /opt/hermes/toolsets.py
COPY --chown=root:root ops/scripts/materialize-persona-toolset-runtime.py /tmp/materialize-persona-toolset-runtime.py

RUN /opt/hermes/.venv/bin/python3 /tmp/materialize-persona-toolset-runtime.py --root /opt/hermes \
    && rm -f /tmp/materialize-persona-toolset-runtime.py \
    && /opt/hermes/.venv/bin/python3 -m py_compile \
      /opt/hermes/gateway/persona_api.py \
      /opt/hermes/gateway/readiness.py \
      /opt/hermes/gateway/platforms/api_server.py \
      /opt/hermes/hermes_cli/tools_config.py \
      /opt/hermes/tools/environments/local.py \
      /opt/hermes/tools/persona_rpc.py \
      /opt/hermes/toolsets.py

CMD ["gateway", "run"]

USER hermes
