index 38af24a2055633960c87f5ad279bf3d36a84ce7d..0cf3862d6f89cd1943533ad08eef3b316649b045 100644
--- a/gateway/session_context.py
+++ b/gateway/session_context.py
@@ -8,8 +8,27 @@ other's routing ids.  ``get_session_env`` is a drop-in for ``os.getenv``.
 import os
 from contextlib import contextmanager
 from contextvars import ContextVar
+from copy import deepcopy
 from typing import Any, Iterator
 
+# Transient request authority: no environment, session-store or history fallback.
+_MCP_METADATA: ContextVar = ContextVar("mcp_request_metadata", default=None)
+
+
+@contextmanager
+def mcp_metadata_scope(metadata: dict | None):
+    """Bind a captured request snapshot and restore the prior scope on every exit."""
+    token = _MCP_METADATA.set(deepcopy(metadata))
+    try:
+        yield
+    finally:
+        _MCP_METADATA.reset(token)
+
+
+def get_mcp_metadata() -> dict | None:
+    """Return an isolated snapshot for capture before an executor/MCP loop hop."""
+    return deepcopy(_MCP_METADATA.get())
+
 # "Never set here" (falls back to os.environ for CLI/cron) vs "" = explicitly cleared (no fallback).
 _UNSET: Any = object()
 
