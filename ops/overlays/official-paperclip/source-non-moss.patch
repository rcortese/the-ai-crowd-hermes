+def test_json_size_boundary():
+    from gateway.platforms.api_server_mcp_metadata import request_mcp_metadata
+    # json.dumps({"x": ""}) is 9 UTF-8 bytes, not compact wire encoding.
+    value = {"x": "a" * 16375}
+    assert request_mcp_metadata({"metadata": {"mcp": value}}, authenticated=True) == value
+    with pytest.raises(ValueError, match="16 KiB"):
+        request_mcp_metadata({"metadata": {"mcp": {"x": "a" * 16376}}}, authenticated=True)
+    assert request_mcp_metadata({"metadata": {"other": True}}, authenticated=False) is None
+
