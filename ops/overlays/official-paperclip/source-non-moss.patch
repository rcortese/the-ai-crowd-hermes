+    monkeypatch.setattr(adapter, "_create_agent", forbidden)
+    async with TestClient(TestServer(make_app(adapter))) as client:
+        response = await client.post(path, data="not json")
+        assert response.status == 401
+        for body in ([], None):
+            response = await client.post(path, headers=AUTH, json=body)
+            assert response.status == 400
+        for metadata in (None, [], {"mcp": None}, {"mcp": []},
