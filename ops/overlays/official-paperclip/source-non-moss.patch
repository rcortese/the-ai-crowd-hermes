+@pytest.fixture
+def native(monkeypatch):
+    loop = asyncio.new_event_loop()
+    ready = threading.Event()
+
+    def serve():
+        asyncio.set_event_loop(loop)
+        loop.call_soon(ready.set)
+        loop.run_forever()
+
+    thread = threading.Thread(target=serve, daemon=True)
+    thread.start()
+    assert ready.wait(5)
+    monkeypatch.setattr(mcp_tool, "_mcp_loop", loop)
+    captured = []
+    sdk = ClientSession(read_stream=AsyncMock(), write_stream=AsyncMock())
+
+    async def send(request, *args, **kwargs):
+        captured.append(request.model_dump(by_alias=True, exclude_none=True))
+        return types.CallToolResult(content=[])
+
+    monkeypatch.setattr(sdk, "send_request", send)
+    validator = "validate_tool_result" if hasattr(sdk, "validate_tool_result") else "_validate_tool_result"
+    monkeypatch.setattr(sdk, validator, AsyncMock())
+    server = SimpleNamespace(session=sdk, _rpc_lock=asyncio.Lock(), _pending_call_context=None)
+    monkeypatch.setattr(mcp_tool_discovery, "_get_connected_server_for_call", lambda _: server)
+    monkeypatch.setattr(mcp_tool, "_server_error_counts", {})
+    handler = mcp_tool_handlers._make_tool_handler("fixture", "inspect", 5)
+    try:
+        yield handler, captured
+    finally:
+        loop.call_soon_threadsafe(loop.stop)
+        thread.join(5)
+        assert not thread.is_alive()
+        loop.close()
+
