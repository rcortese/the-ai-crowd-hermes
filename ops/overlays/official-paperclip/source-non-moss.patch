+def test_scope_resets_after_failure_and_copies(native):
+    from gateway.session_context import get_mcp_metadata, mcp_metadata_scope
+    handler, captured = native
+    value = {"trace": {"id": "original"}}
+    with pytest.raises(RuntimeError):
+        with mcp_metadata_scope(value):
+            value["trace"]["id"] = "changed"
+            snapshot = get_mcp_metadata()
+            snapshot["trace"]["id"] = "forged"
+            assert "error" not in json.loads(handler({}))
+            with mcp_metadata_scope(None):
+                assert get_mcp_metadata() is None
+            assert get_mcp_metadata() == {"trace": {"id": "original"}}
+            raise RuntimeError("test cleanup")
+    assert get_mcp_metadata() is None
+    handler({"_meta": {"forged": True}}, meta={"forged": True}, metadata={"mcp": {"forged": True}})
+    assert captured[0]["params"]["_meta"] == {"trace": {"id": "original"}}
+    assert "_meta" not in captured[1]["params"]
+    assert captured[1]["params"]["arguments"] == {"_meta": {"forged": True}}
