+@pytest.mark.asyncio
+@pytest.mark.parametrize("path,payload", ENDPOINTS)
+async def test_auth_and_validation_before_effects(native, monkeypatch, path, payload):
+    _, captured = native
+    adapter = api_server.APIServerAdapter(PlatformConfig(enabled=True, extra={"key": "test-key"}))
+
+    def forbidden(**kw):
+        pytest.fail("Invalid request created an agent")
