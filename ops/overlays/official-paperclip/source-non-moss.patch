+@pytest.mark.asyncio
+async def test_overlapping_runs_and_successor(native, monkeypatch):
+    from gateway.session_context import get_mcp_metadata
+    handler, captured = native
+    adapter = api_server.APIServerAdapter(PlatformConfig(enabled=True, extra={"key": "test-key"}))
+    barrier = threading.Barrier(2)
+    db = await adapter._ensure_session_db_async()
+    assert db is not None
+    db.create_session("shared", "api_server")
+    observed_inputs = []
+
+    class Agent:
+        def run_conversation(self, **kwargs):
+            observed_inputs.append(kwargs)
+            if kwargs["user_message"] in {"first", "second"}:
+                barrier.wait(5)
+            with ThreadPoolExecutor(1) as pool:
+                result = pool.submit(propagate_context_to_thread(handler),
+                                     {"value": kwargs["user_message"]}, meta={"forged": True}).result(5)
+            assert "error" not in json.loads(result), result
+            return {"final_response": "done", "messages": []}
+
+    monkeypatch.setattr(adapter, "_create_agent", lambda **kw: Agent())
+    # Warm existing lazy imports before measuring environment invariance.
+    import gateway.run  # noqa: F401
+    handler({"value": "warmup"})
+    captured.clear()
+    before = dict(os.environ)
+    metas = [{"trace": {"id": "one", "nested": [1, True]}}, {"trace": {"id": "two"}}]
+    async with TestClient(TestServer(make_app(adapter))) as client:
+        ids = []
+        for text, meta in zip(("first", "second"), metas):
+            response = await client.post("/v1/runs", headers=AUTH, json={
+                "input": text, "session_id": "shared", "metadata": {"mcp": meta}})
+            assert response.status == 202, await response.text()
+            ids.append((await response.json())["run_id"])
+        await asyncio.gather(*(finish(client, rid) for rid in ids))
+        for text, metadata in (("successor", {"mcp": {"trace": "successor"}}), ("absent", None)):
+            body: dict = {"input": text, "session_id": "shared"}
+            if metadata is not None:
+                body["metadata"] = metadata
+            response = await client.post("/v1/runs", headers=AUTH, json=body)
+            assert response.status == 202, await response.text()
+            rid = (await response.json())["run_id"]
+            await finish(client, rid)
+            # Runs SSE consumes the same completed run, not a second authority.
+            events = await client.get(f"/v1/runs/{rid}/events", headers=AUTH)
+            assert events.status == 200
+            assert "run.completed" in await events.text()
+    by_value = {c["params"]["arguments"]["value"]: c for c in captured}
+    for text, meta in zip(("first", "second"), metas):
+        assert by_value[text] == {"method": "tools/call", "params": {
+            "name": "inspect", "arguments": {"value": text}, "_meta": meta}}
+    assert by_value["successor"]["params"]["_meta"] == {"trace": "successor"}
+    assert "_meta" not in by_value["absent"]["params"]
+    assert all(set(i) == {"user_message", "conversation_history", "task_id"} for i in observed_inputs)
+    assert get_mcp_metadata() is None
+    assert dict(os.environ) == before
+
