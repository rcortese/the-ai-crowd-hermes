index 0000000000000000000000000000000000000000..71186a8180076a316151f246545cdcf53e11833e
--- /dev/null
+++ b/gateway/platforms/api_server_mcp_metadata.py
@@ -0,0 +1,29 @@
+"""Validation of transient API-to-native-MCP metadata (not model/tool arguments)."""
+import json
+from typing import Any
+
+
+def request_mcp_metadata(body: Any, *, authenticated: bool) -> dict | None:
+    """Call only after request authentication; return a detached finite JSON object."""
+    if not isinstance(body, dict):
+        raise ValueError("Request body must be an object")
+    if "metadata" not in body:
+        return None
+    metadata = body["metadata"]
+    if not isinstance(metadata, dict):
+        raise ValueError("metadata must be an object")
+    if "mcp" not in metadata:
+        return None
+    if not authenticated:
+        raise ValueError("metadata.mcp requires authenticated API access")
+    value = metadata["mcp"]
+    if not isinstance(value, dict):
+        raise ValueError("metadata.mcp must be an object")
+    try:
+        encoded = json.dumps(value, ensure_ascii=False, allow_nan=False)
+        size = len(encoded.encode("utf-8"))
+    except (ValueError, TypeError, RecursionError, UnicodeError):
+        raise ValueError("metadata.mcp must contain valid JSON") from None
+    if size > 16 * 1024:
+        raise ValueError("metadata.mcp exceeds 16 KiB")
+    return json.loads(encoded)
