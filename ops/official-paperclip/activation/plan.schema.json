{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAC-246 complete Moss-only activation plan; never store credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","scope","host","code","source","files","preimage","siblings","render","invariants","installed","catalog","continuation","timeouts","ingresses","adapter"],
  "properties": {
    "schema": {"const": 1},
    "scope": {"const": "tac246-moss-only"},
    "host": {"const": "MEDIA"},
    "code": {"$ref": "#/$defs/sha"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["root","commit","tree","uid","mode","paths"],
      "properties": {
        "root": {"const": "/mnt/user/appdata/the-ai-crowd/deployment-private/moss/tac246-activation/source"},
        "commit": {"$ref": "#/$defs/oid"}, "tree": {"$ref": "#/$defs/oid"},
        "uid": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "enum": [448,493]},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^ops/official-paperclip/activation/[^.][A-Za-z0-9_.-]*$"}}
      }
    },
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["config","compose","override","transformer"],
      "properties": {"config": {"$ref": "#/$defs/file"}, "compose": {"$ref": "#/$defs/file"},
                     "override": {"$ref": "#/$defs/file"}, "transformer": {"$ref": "#/$defs/file"}}
    },
    "preimage": {"$ref": "#/$defs/identity"},
    "siblings": {
      "type": "object", "additionalProperties": false, "required": ["denholm","jen","richmond"],
      "properties": {"denholm": {"$ref": "#/$defs/sibling"}, "jen": {"$ref": "#/$defs/sibling"},
                     "richmond": {"$ref": "#/$defs/sibling"}}
    },
    "render": {"$ref": "#/$defs/sha"}, "invariants": {"$ref": "#/$defs/sha"},
    "installed": {"type": "object", "minProperties": 6, "maxProperties": 6,
                  "additionalProperties": {"$ref": "#/$defs/sha"}},
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["count","sha"],
      "properties": {"count": {"const": 44}, "sha": {"$ref": "#/$defs/sha"}}
    },
    "continuation": {
      "type": "object", "additionalProperties": false, "required": ["session","session_sha","memory_off_evidence"],
      "properties": {
        "session": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$", "not": {"const": "df6e86989771"}},
        "session_sha": {"$ref": "#/$defs/sha"}, "memory_off_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "adapter": {"$ref": "#/$defs/evidence"},
    "ingresses": {"const": ["gateway","api","webui"]},
    "timeouts": {
      "type": "object", "additionalProperties": false, "required": ["idle","drain","child","interval","continuation"],
      "properties": {"idle": {"$ref": "#/$defs/timeout"}, "drain": {"$ref": "#/$defs/timeout"},
                     "child": {"$ref": "#/$defs/timeout"}, "continuation": {"$ref": "#/$defs/timeout"},
                     "interval": {"type": "number", "minimum": 1, "maximum": 3}}
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path","pre","post","uid","mode"],
      "properties": {
        "path": {"type": "string", "enum": [
          "/mnt/user/appdata/the-ai-crowd/moss/home/profiles/moss/config.yaml",
          "/mnt/user/appdata/the-ai-crowd/compose.yaml",
          "/mnt/user/appdata/the-ai-crowd/deployment-private/moss/moss-image.override.json",
          "/mnt/user/appdata/the-ai-crowd/deployment-private/moss/tac246-activation/inputs/configure.py"]},
        "pre": {"$ref": "#/$defs/sha"}, "post": {"$ref": "#/$defs/sha"},
        "uid": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "enum": [384,416,420]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path","sha","uid"],
      "properties": {"path": {"type": "string", "pattern": "^/mnt/user/appdata/the-ai-crowd/deployment-private/moss/tac246-activation/inputs/[A-Za-z0-9_-]+\\.json$"},
                     "sha": {"$ref": "#/$defs/sha"}, "uid": {"type": "integer", "minimum": 0}}
    },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["id","image","started","restarts","running"],
      "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                     "image": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                     "started": {"type": "string", "minLength": 1}, "restarts": {"type": "integer", "minimum": 0},
                     "running": {"const": true}}
    },
    "sibling": {
      "type": "object", "additionalProperties": false, "required": ["identity","invariants"],
      "properties": {"identity": {"$ref": "#/$defs/identity"}, "invariants": {"$ref": "#/$defs/sha"}}
    }
  }
}
