TZ=UTC
HERMES_DASHBOARD_TUI=1
# Run containers as the deployment checkout owner to prevent bind-mounted files
# from becoming owned by root or the image's internal user.
HERMES_UID=1000
HERMES_GID=1000
# Fill per-agent model/API credentials through Hermes dashboard or non-git .env files.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Required by compose.yaml (private values; never commit real ones).
# MOSS_TO_DENHOLM_A2A_TOKEN=
# ROY_TELEGRAM_BOT_TOKEN=
# ROY_TELEGRAM_ALLOWED_USERS=
# ROY_TELEGRAM_HOME_CHANNEL=
# ROY_DELIVERY_WEBUI_BASE_URL=
# RICHMOND_RELEASE_PRIVATE_DIR=
# RICHMOND_WORKER_PRIVATE_DIR=
# RICHMOND_INBOX_DIR=

# Optional overrides.
# MOSS_TELEGRAM_BOT_TOKEN=
# MOSS_RUNTIME_RELEASE=          # Moss runtime snapshot id under runtime/
# THE_AI_CROWD_PROXY_NETWORK=example-proxy-network
# THE_AI_CROWD_BACKUP_ROOT=./state/private/backups
# ROY_TRANSFER_ROOT=./state/private/roy-transfer
